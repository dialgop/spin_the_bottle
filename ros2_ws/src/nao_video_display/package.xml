<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>nao_video_display</name>
  <version>0.0.1</version>
  <description>Renders the bottle-spin video NAO is watching onto a Display device inside the Webots simulation, via a custom webots_ros2_driver plugin.</description>

  <maintainer email="dialgop@gmail.com">Diego Alejandro Gomez Pardo</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>webots_ros2_driver</depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
